    "@vitejs/plugin-react": "^6.1.1",
    "@wavesurfer/react": "^1.0.12",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "marked": "^18.0.14",
    "motion": "^13.4.4",
    "opensheetmusicdisplay": "^2.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.1",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "react-window": "^2.3.3",
    "remark-gfm": "^4.0.1",
    "signalsmith-stretch": "^1.3.2",
    "spessasynth_core": "^4.3.22",
    "spessasynth_lib": "^4.3.14",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.186.1",
    "vite": "^8.3.1",
    "wavesurfer.js": "^8.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "node-domexception": "file:vendor/node-domexception",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "node-domexception": "$node-domexception",
    "gl": "npm:empty-npm-package@^1.0.0"
  }
}
