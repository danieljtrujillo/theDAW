# Staged headless notation engraver (frontend/scripts + ~49 MB of production
# node_modules), regenerated at package time by scripts/fetch-notation-renderer.mjs.
# The sibling staging dirs (resources/tools, resources/vj-dist, resources/foundry-app)
# are ignored from the repo-root .gitignore; this entry belongs beside them.
resources/notation-renderer/

# Staged live-VST host exe (+ vst3_probe.exe), regenerated at package time by
# scripts/stage-vst-host.mjs from native/vst-host/bin. See electron-builder.yml
# (win.extraResources) for where it lands in the packaged app.
build-resources/vst-host/

# Apple Silicon FFmpeg (ffmpeg, ffprobe, ffmpeg-libs/), built by
# scripts/build-ffmpeg-macos.sh in the macos-dmg release job and copied into
# resources/tools by scripts/fetch-runtime-tools.mjs.
build-resources/ffmpeg-macos-arm64/
