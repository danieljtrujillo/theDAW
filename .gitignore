frontend.bak*/

# TypeScript incremental build cache — regenerated by tsc -b on every build,
# noisy in diffs, and machine-specific timestamps.
*.tsbuildinfo

# Node dependency folders — generated by npm/pnpm/yarn installs. Keep lockfiles
# committed, but never vendor package trees from frontend or sidecars.
node_modules/

# Local backup snapshots — never commit
_RECOVERY_BACKUP/


# Reference PDFs kept locally, not version-controlled (large binaries)
docs/*.pdf

# Local archive of superseded/scratch files (see archive/README.md) — not tracked
/archive/
/research/
.vite/
.orb_attachments/

# Generated exports (VJ renders, transcodes, PNG-sequence zips, etc.) — NEVER
# commit exports of any kind. The VJ exporter writes here by default.
/exports/

# Session changelogs — local dev notes, not version-controlled
/docs/changes/

# Session/branch reports — local working notes, not version-controlled
/docs/reports/

# Loose capture stills & scratch media at repo root (mirror the *.png policy so
# ad-hoc .jpeg screenshots like shot01_*.jpeg never get committed). Anchored to
# root so frontend image assets are unaffected.
/*.jpeg
/*.jpg
/.tmp-shots/

# VS Code workspace files are per-user / machine-specific — never commit.
*.code-workspace

# Showcase assets are local-only (demo video, screenshots, scripts, raw media).
# Kept on disk but not shipped in everyone's clone.
/showcase/

# Root-level scratch artifacts (debug dumps, one-off harnesses, reference
# prototypes, personal media) stay local. Anchored to root so real assets
# elsewhere are unaffected.
/_*.json
/_*.py
/*.mp3
/dna-polyphonic-splice*.html
/temp-tools/doc-audit-*/
/temp-tools/doc-audit-manifest.json

# Local audit artifacts: vulnerability details stay off the remote.
/CODEBASE_AUDIT_*.md
/audit-reports/

# Internal working-notes and status docs — local only, not user documentation.
# Kept out of the tracked tree and the installer.
/docs/plans/
/docs/audits/
/docs/changes/
/docs/in-flight-work.md
/docs/WHERE-WE-STAND.md
/docs/TASMO-VST-DAW-IMPORT-ROADMAP.md
/docs/DESIGN_PRINCIPLES.md
/docs/DESIGN_WIREFRAME.svg

# Electron desktop shell — build artifacts + runtime logs (deps via node_modules/ above)
electron-ui/out/
electron-ui/release/
# Bundled runtime binaries fetched at build time (uv.exe, ffmpeg.exe) — large,
# downloaded from official sources by scripts/fetch-runtime-tools.mjs.
electron-ui/resources/tools/
# Staged VJ production build (gantasmo/VJ-9000 dist), regenerated at package
# time by scripts/fetch-vj-build.mjs.
electron-ui/resources/vj-dist/
# Staged SwayCommand cockpit embed build (SwayCommand's `npm run
# build:renderer:embed` output). Build artifact of a separate repo — stage it,
# don't commit it. backend/modules/sway/sidecar.py also accepts a theDAW_SWAY_DIST
# override or a sibling SwayCommand checkout.
electron-ui/resources/sway-dist/
# Staged VST Foundry production bundle (dist/ + prod node_modules), regenerated
# at package time by scripts/fetch-foundry-build.mjs.
electron-ui/resources/foundry-app/
logs/

# Editing/backup cruft (e.g. vendored apps' *.bak-<date> files)
*.bak
*.bak-*
deprecated/

# Local model weights (multi-GB safetensors + configs) - never commit.
# ROOT-anchored on purpose: a bare `models/` matches at any depth and was
# silently swallowing underfit/dashboard/models/ — the small registry JSON
# files the Underfit dashboard builds its model list from — so every clone
# and Pinokio install got an empty model picker (GH-133).
/models/

# Underfit is vendored as a git-subrepo (dada-bots/underfit + local mods): its
# CODE is tracked by theDAW; only its heavy runtime dirs are excluded here (also
# covered by underfit/.gitignore). state/ is multi-GB — never commit it.
/underfit/state/
/underfit/.venv/
/underfit/.gradio/
/underfit/**/node_modules/
/underfit/**/__pycache__/

# Stems sidecar (integration-package/backend) runtime artifacts.
# Only the sidecar's code is committed; its venv, logs, results, and the
# LARSNET weights are created or placed at runtime.
integration-package/backend/.sidecar_venv/
integration-package/backend/.sidecar_logs/
integration-package/backend/.sidecar_venv_requirements.txt
integration-package/backend/backend_port.txt
integration-package/backend/logs/
integration-package/backend/results/
integration-package/backend/larsnet/pretrained_larsnet_models/
integration-package/backend/larsnet/pretrained_larsnet_models.zip

# Untracked video/marketing scripts (local working material, not part of the product).
video-scripts/


